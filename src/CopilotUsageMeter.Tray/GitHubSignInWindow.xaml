<Window x:Class="CopilotUsageMeter.Tray.GitHubSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to GitHub" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Sign in to GitHub" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Sign-in status" />
        <TextBox x:Name="CodeBox" IsReadOnly="True" Visibility="Collapsed" FontFamily="Consolas" FontSize="36" FontWeight="Bold"
                 TextAlignment="Center" Margin="0,16,0,0" Padding="0,8" AutomationProperties.Name="One-time code" />
        <Button x:Name="CopyButton" Visibility="Collapsed" Click="CopyClicked" Margin="0,12,0,0" Padding="12,6" IsDefault="True"
                Content="Copy code and open GitHub" AutomationProperties.Name="Copy code and open GitHub" />
        <TextBlock x:Name="HintText" Visibility="Collapsed" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Sign-in hint" />
        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="4" Margin="0,16,0,0" BorderThickness="0" Background="Transparent" Foreground="#2F6FDE" AutomationProperties.Name="Working" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ChooseButton" Visibility="Collapsed" Click="ChooseClicked" Padding="12,4" Margin="0,0,8,0" Content="Choose account" AutomationProperties.Name="Choose account" />
            <Button x:Name="RetryButton" Visibility="Collapsed" Click="RetryClicked" Padding="12,4" Margin="0,0,8,0" Content="Try again" AutomationProperties.Name="Try again" />
            <Button x:Name="CloseButton" Click="CloseClicked" Padding="12,4" IsCancel="True" Content="Cancel" AutomationProperties.Name="Cancel sign-in" />
        </StackPanel>
    </StackPanel>
</Window>
