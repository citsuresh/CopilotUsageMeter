<Window x:Class="CopilotUsageMeter.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copilot Usage Meter - Full details" Height="620" Width="560" MinHeight="420" MinWidth="460"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Copilot Usage Meter" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" FontSize="12" Margin="8,4,0,0" VerticalAlignment="Center" AutomationProperties.Name="Tray version" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PauseButton" Click="PauseClicked" Padding="8,2" Margin="0,0,8,0" FontSize="12" AutomationProperties.Name="Pause updates">
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="PauseGlyph" Text="&#xE769;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock x:Name="PauseLabel" Text="Pause updates" /></StackPanel>
                </Button>
                <Border x:Name="StatusChip" CornerRadius="10" Padding="10,2" VerticalAlignment="Center" Background="#2F6FDE">
                    <TextBlock x:Name="StatusText" Foreground="White" FontSize="12" AutomationProperties.Name="Tracking status" />
                </Border>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="BusyBar" Grid.Row="0" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Margin="20,0,20,3" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Foreground="#2F6FDE" AutomationProperties.Name="Working" />
        <Border x:Name="FaultBanner" Grid.Row="1" Visibility="Collapsed" Margin="20,0,20,8" Padding="10,8" Background="#D13438" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FaultText" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="Problem" />
                <Button Grid.Column="1" Content="Dismiss" Click="DismissFaultClicked" Padding="10,3" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,12">
                <StackPanel x:Name="GitHubHost" />
                <StackPanel x:Name="LocalHost" Margin="0,18,0,0" />
                <StackPanel x:Name="ChartHost" Margin="0,18,0,0" />
                <Expander Header="Account details" Margin="0,18,0,0" AutomationProperties.Name="Account details">
                    <StackPanel x:Name="AccountRowsHost" Margin="0,6,0,0" />
                </Expander>
                <Expander Header="Local details" Margin="0,6,0,0" AutomationProperties.Name="Local details">
                    <StackPanel x:Name="LocalRowsHost" Margin="0,6,0,0" />
                </Expander>
                <Expander x:Name="DetailsExpander" Header="Usage breakdown (this machine)" Margin="0,6,0,0" AutomationProperties.Name="Usage breakdown for this machine">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Text="Local analytics recorded on this machine only. This is not GitHub account usage and is not expected to match it. It is read on demand and never uploaded." />
                        <WrapPanel Margin="0,8,0,0">
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Range (UTC days)" FontSize="11" />
                                <ComboBox x:Name="DetailsRangeBox" Width="150" SelectedIndex="1" SelectionChanged="DetailsRangeChanged" AutomationProperties.Name="Date range">
                                    <ComboBoxItem Content="Last 7 days" />
                                    <ComboBoxItem Content="Last 30 days" />
                                    <ComboBoxItem Content="Last 90 days" />
                                    <ComboBoxItem Content="This month" />
                                    <ComboBoxItem Content="Last month" />
                                    <ComboBoxItem Content="Custom dates" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="DetailsCustomPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,6">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="From" FontSize="11" />
                                    <DatePicker x:Name="DetailsFromPicker" Width="130" AutomationProperties.Name="From date" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="To (inclusive)" FontSize="11" />
                                    <DatePicker x:Name="DetailsToPicker" Width="130" AutomationProperties.Name="To date" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Group by" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <CheckBox x:Name="DetailsDayBox" Content="Day" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Group by day" />
                            <CheckBox x:Name="DetailsRepositoryGroupBox" Content="Repository" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Group by repository" />
                            <CheckBox x:Name="DetailsModelGroupBox" Content="Model" VerticalAlignment="Center" AutomationProperties.Name="Group by model" />
                        </StackPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Repository (owner/name)" FontSize="11" />
                                <TextBox x:Name="DetailsRepositoryBox" Width="210" MaxLength="140" VerticalContentAlignment="Center" AutomationProperties.Name="Repository filter, owner slash name" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Model" FontSize="11" />
                                <TextBox x:Name="DetailsModelBox" Width="150" MaxLength="100" VerticalContentAlignment="Center" AutomationProperties.Name="Model filter" />
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ShowDetailsButton" Content="Show breakdown" Click="ShowDetailsClicked" Padding="12,4" Margin="0,0,8,0" AutomationProperties.Name="Show usage breakdown" />
                            <Button x:Name="CancelDetailsButton" Content="Cancel" Click="CancelDetailsClicked" Padding="12,4" Visibility="Collapsed" AutomationProperties.Name="Cancel reading usage breakdown" />
                            <Button x:Name="ExportDetailsButton" Content="Export…" Click="ExportDetailsClicked" Padding="12,4" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Save this breakdown and your GitHub account figures as CSV or JSON" AutomationProperties.Name="Export usage breakdown" />
                        </StackPanel>
                        <TextBlock x:Name="DetailsStatusText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Usage breakdown status" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                            <StackPanel x:Name="DetailsResultsHost" />
                        </ScrollViewer>
                    </StackPanel>
                </Expander>
                <Expander Header="Diagnostics" Margin="0,6,0,0" AutomationProperties.Name="Diagnostics">
                    <StackPanel x:Name="DiagnosticRowsHost" Margin="0,6,0,0" />
                </Expander>
                <Expander Header="Connect a GitHub account" Margin="0,6,0,0" AutomationProperties.Name="Connect a GitHub account">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Browser sign-in connects automatically when GitHub CLI finishes. To connect manually, leave the login blank to use the single signed-in GitHub CLI login, or enter a login (never a token). Only Windows Credential Manager storage is accepted. Connecting switches this app's account; local history is not reassigned." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="AccountLogin" Width="230" MaxLength="39" VerticalContentAlignment="Center" AutomationProperties.Name="GitHub login" />
                            <Button Content="Connect account" Click="ConnectClicked" Padding="12,6" Margin="8,0,0,0" />
                            <Button Content="Skip account" Click="SkipClicked" Padding="12,6" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="20,4,20,12">
            <StackPanel x:Name="AccountChoices" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock x:Name="AccountChoicesTitle" Text="Choose a GitHub account:" TextWrapping="Wrap" FontWeight="SemiBold" />
                <WrapPanel x:Name="AccountChoiceButtons" Margin="0,6,0,0" />
            </StackPanel>
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.Name="Last command result" />
            <StackPanel x:Name="RemoveAccountConfirm" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock x:Name="RemoveAccountTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="RemoveAccountDetail" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Cancel" Click="CancelRemoveAccountClicked" Padding="12,4" Margin="0,0,8,0" />
                    <Button x:Name="ConfirmRemoveAccountButton" Content="Remove" Click="ConfirmRemoveAccountClicked" Padding="12,4" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="LogOutConfirm" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="Log out of GitHub?" FontWeight="SemiBold" />
                <TextBlock Text="Local tracking continues. You can sign in again anytime." />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Cancel" Click="CancelLogOutClicked" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Log out" Click="ConfirmLogOutClicked" Padding="12,4" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </StackPanel>
            </StackPanel>
            <WrapPanel x:Name="Toolbar">
                <Button x:Name="RefreshButton" Click="RefreshClicked" Padding="12,6" Margin="0,0,8,4" AutomationProperties.Name="Refresh now">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Refresh now" /></StackPanel>
                </Button>
                <Button x:Name="SwitchButton" Click="SignInClicked" Padding="12,6" Margin="0,0,8,4" AutomationProperties.Name="Switch GitHub account">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock x:Name="SwitchLabel" Text="Switch account" /></StackPanel>
                </Button>
                <Button x:Name="AlertsButton" Click="AlertsClicked" Padding="12,6" Margin="0,0,8,4" AutomationProperties.Name="Usage alerts">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Alerts…" /></StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Click="SettingsClicked" Padding="12,6" Margin="0,0,8,4" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Settings…" /></StackPanel>
                </Button>
                <Button x:Name="LogOutButton" Click="LogOutClicked" Padding="12,6" Margin="0,0,8,4" AutomationProperties.Name="Log out of GitHub">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" /><TextBlock Text="Log out…" /></StackPanel>
                </Button>
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                       Text="Closing this window keeps tracking. Exit from the tray menu stops it. Local history is never uploaded. GitHub sign-in is optional; local history is not attributed to the signed-in account." />
        </StackPanel>
    </Grid>
</Window>
