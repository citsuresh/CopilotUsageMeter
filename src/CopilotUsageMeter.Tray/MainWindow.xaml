<Window x:Class="CopilotUsageMeter.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CopilotUsageMeter.Tray"
        mc:Ignorable="d"
        Title="Copilot Usage Meter - Phase 2 Demo" Height="460" Width="600" MinHeight="440" MinWidth="560">
    <StackPanel Margin="24">
        <TextBlock Text="PHASE 2 DEMO - invented data only" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
        <TextBlock x:Name="StatusText" Margin="0,0,0,12" />
        <TextBlock Text="Demo account (not GitHub-reported usage)" FontWeight="Bold" />
        <TextBlock x:Name="AccountText" TextWrapping="Wrap" Margin="0,4,0,12" />
        <TextBlock Text="Demo local analytics (this-machine scope; not billing)" FontWeight="Bold" />
        <TextBlock x:Name="LocalText" TextWrapping="Wrap" Margin="0,4,0,12" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh demo" Click="RefreshClicked" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="PauseButton" Content="Pause updates" Click="PauseClicked" Padding="12,6" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="Demo refresh (5-300 seconds):" Target="{Binding ElementName=IntervalText}" VerticalAlignment="Center" />
            <TextBox x:Name="IntervalText" Width="55" VerticalContentAlignment="Center" />
            <Button Content="Save settings" Click="SaveClicked" Padding="12,6" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBlock Text="Closing this window keeps the tray engine running. Use the tray menu's Exit to stop it. Authentication, real usage and chat embedding are not implemented." TextWrapping="Wrap" />
    </StackPanel>
</Window>
