<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CopilotUsageMeter.Core\CopilotUsageMeter.Core.csproj" />
    <ProjectReference Include="..\CopilotUsageMeter.Contracts\CopilotUsageMeter.Contracts.csproj" />
    <ProjectReference Include="..\CopilotUsageMeter.Readers.ChatHistoryCli\CopilotUsageMeter.Readers.ChatHistoryCli.csproj" />
    <ProjectReference Include="..\CopilotUsageMeter.Readers.GitHub\CopilotUsageMeter.Readers.GitHub.csproj" />
    <ProjectReference Include="..\CopilotUsageMeter.Signals.FileWatcher\CopilotUsageMeter.Signals.FileWatcher.csproj" />
    <ProjectReference Include="..\CopilotUsageMeter.Transport.Pipes\CopilotUsageMeter.Transport.Pipes.csproj" />
    <ProjectReference Include="..\CopilotUsageMeter.Client\CopilotUsageMeter.Client.csproj" />
    <ProjectReference Include="..\CopilotUsageMeter.Panel.Core\CopilotUsageMeter.Panel.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\chathistory\**\*" Link="tools\chathistory\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckHistoryTool" BeforeTargets="Build" Condition="!Exists('..\..\tools\chathistory\chathistory.exe')">
    <Warning Text="Portable chathistory CLI is absent. Publish the toolkit into tools\chathistory before running local tracking; it will otherwise show unavailable." />
  </Target>

</Project>
